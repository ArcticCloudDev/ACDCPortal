{
  "name": "acdc-portal",
  "version": "1.0.0",
  "description": "ACDC Team Registration Portal",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -n STORAGE,API,WEB -c magenta,yellow,cyan \"npm run dev:storage\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:storage": "azurite --silent --location .azurite --disableTelemetry",
    "dev:api": "npm --prefix api start",
    "dev:web": "node server.js",
    "build": "echo 'No build step required - static files'",
    "test": "echo 'No tests configured yet'"
  },
  "keywords": ["azure", "static-web-apps", "entra", "otp"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.0.0",
    "http-proxy-middleware": "^3.0.5",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "azurite": "^3.35.0"
  }
}
