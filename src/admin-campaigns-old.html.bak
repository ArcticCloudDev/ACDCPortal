<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Campaigns - ACDC Admin</title>
    <link rel="stylesheet" href="css/admin-styles.css">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <style>
        /* Page-specific styles */
        .page-title { font-size: 1.5rem; font-weight: 600; color: var(--admin-sidebar); margin: 0; }

        /* Tabs */
        .tabs { display: flex; gap: 4px; margin-bottom: 24px; border-bottom: 1px solid var(--admin-border); }
        .tab {
            padding: 10px 20px;
            background: none;
            border: none;
            font-size: 0.9rem;
            color: var(--admin-text-muted);
            cursor: pointer;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
        }
        .tab:hover { color: var(--admin-text); }
        .tab.active { color: var(--admin-primary); border-bottom-color: var(--admin-primary); font-weight: 500; }

        .tab-content { display: none; }
        .tab-content.active { display: block; }

        /* Panel */
        .panel {
            background: white;
            border-radius: 8px;
            border: 1px solid var(--admin-border);
            margin-bottom: 24px;
        }

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 18px;
            border-bottom: 1px solid var(--admin-border);
        }

        .panel-title { font-size: 0.9rem; font-weight: 600; color: var(--admin-sidebar); }
        .panel-body { padding: 20px; }

        /* Form */
        .form-group { margin-bottom: 16px; }
        .form-group label { display: block; margin-bottom: 6px; font-weight: 500; font-size: 0.85rem; }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 8px 12px;
            border: 1px solid var(--admin-border);
            border-radius: 6px;
            font-size: 0.875rem;
        }
        .form-group input:focus, .form-group select:focus {
            outline: none;
            border-color: var(--admin-primary);
            box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
        }

        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

        /* Buttons */
        .btn {
            padding: 8px 16px;
            border: none;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-primary { background: var(--admin-primary); color: white; }
        .btn-primary:hover { background: #2563eb; }
        .btn-secondary { background: white; border: 1px solid var(--admin-border); color: var(--admin-text); }
        .btn-secondary:hover { background: var(--admin-bg); }
        .btn-danger { background: var(--admin-danger); color: white; }
        .btn-danger:hover { background: #dc2626; }
        .btn-success { background: var(--admin-success); color: white; }
        .btn-success:hover { background: #059669; }
        .btn-sm { padding: 5px 10px; font-size: 0.75rem; }

        .btn-row { display: flex; gap: 10px; margin-top: 16px; }

        /* Quill editor */
        .ql-container { min-height: 200px; }
        .ql-toolbar { border-radius: 6px 6px 0 0 !important; background: #f8fafc; }
        .ql-container { border-radius: 0 0 6px 6px !important; }

        /* Table */
        .data-table { width: 100%; border-collapse: collapse; }
        .data-table th {
            text-align: left;
            padding: 10px 12px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--admin-text-muted);
            background: var(--admin-bg);
            border-bottom: 1px solid var(--admin-border);
        }
        .data-table td {
            padding: 10px 12px;
            border-bottom: 1px solid var(--admin-border);
            font-size: 0.85rem;
        }
        .data-table tbody tr:hover { background: #f8fafc; }

        /* Badges */
        .badge {
            display: inline-flex;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 500;
        }
        .badge.sequence { background: #dbeafe; color: #1d4ed8; }
        .badge.broadcast { background: #f3e8ff; color: #7c3aed; }
        .badge.sent { background: #d1fae5; color: #065f46; }
        .badge.failed { background: #fee2e2; color: #b91c1c; }
        .badge.pending { background: #fef3c7; color: #92400e; }

        /* Stats */
        .stats-row { display: flex; gap: 24px; margin-bottom: 16px; }
        .stat { text-align: center; }
        .stat .value { font-size: 1.5rem; font-weight: 600; color: var(--admin-sidebar); }
        .stat .label { font-size: 0.75rem; color: var(--admin-text-muted); }

        /* Preview */
        .preview-frame {
            width: 100%;
            height: 400px;
            border: 1px solid var(--admin-border);
            border-radius: 6px;
            background: white;
        }

        /* Radio group for type */
        .type-group { display: flex; gap: 12px; }
        .type-option {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 16px;
            border: 2px solid var(--admin-border);
            border-radius: 6px;
            cursor: pointer;
            flex: 1;
        }
        .type-option:hover { border-color: var(--admin-primary); }
        .type-option.selected { border-color: var(--admin-primary); background: #eff6ff; }
        .type-option input { display: none; }
        .type-option .icon { font-size: 1.2rem; }
        .type-option .label { font-weight: 500; }
        .type-option .desc { font-size: 0.75rem; color: var(--admin-text-muted); }

        .empty-state { padding: 40px; text-align: center; color: var(--admin-text-muted); }

        .hidden { display: none !important; }

        /* Event sequence card */
        .event-sequence-card {
            background: white;
            border-radius: 8px;
            border: 1px solid var(--admin-border);
            margin-bottom: 20px;
            overflow: hidden;
        }
        
        .event-sequence-header {
            padding: 16px 20px;
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            border-bottom: 1px solid var(--admin-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .event-sequence-header h3 {
            margin: 0;
            font-size: 1rem;
            font-weight: 600;
            color: var(--admin-sidebar);
        }
        
        .event-sequence-header .event-meta {
            font-size: 0.8rem;
            color: var(--admin-text-muted);
            margin-top: 4px;
        }
        
        .event-sequence-body {
            padding: 0;
        }
        
        .sequence-item {
            padding: 14px 20px;
            border-bottom: 1px solid var(--admin-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .sequence-item:last-child {
            border-bottom: none;
        }
        
        .sequence-item:hover {
            background: #f8fafc;
        }
        
        .sequence-info {
            flex: 1;
        }
        
        .sequence-subject {
            font-weight: 500;
            color: var(--admin-sidebar);
            margin-bottom: 4px;
        }
        
        .sequence-stats {
            font-size: 0.75rem;
            color: var(--admin-text-muted);
        }
        
        .sequence-actions {
            display: flex;
            gap: 8px;
        }
        
        .no-sequence {
            padding: 20px;
            text-align: center;
            color: var(--admin-text-muted);
            font-size: 0.9rem;
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }
        
        .modal.active {
            display: flex;
        }
        
        .modal-content {
            background: white;
            border-radius: 8px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        }
        
        .modal-header {
            padding: 20px;
            border-bottom: 1px solid var(--admin-border);
        }
        
        .modal-header h3 {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 600;
        }
        
        .modal-body {
            padding: 20px;
        }
        
        .modal-footer {
            padding: 16px 20px;
            border-top: 1px solid var(--admin-border);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .warning-box {
            background: #fef3c7;
            border: 1px solid #fde047;
            border-radius: 6px;
            padding: 12px;
            margin-bottom: 16px;
            font-size: 0.85rem;
            color: #78350f;
        }
    </style>
</head>
<body>
    <div class="admin-layout">
        <div id="sidebar-container"></div>

        <main class="main-content" id="admin-content">
            <div class="page-header">
                <h1 class="page-title">📧 Sequence Emails</h1>
                <div>
                    <select id="event-filter" style="padding: 8px 12px; border-radius: 6px; border: 1px solid var(--admin-border);">
                        <option value="">All Events</option>
                    </select>
                    <button class="btn btn-primary" onclick="showCreateForm()">➕ New Sequence Email</button>
                </div>
            </div>

            <p style="margin-bottom: 20px; color: var(--admin-text-muted); font-size: 0.9rem;">
                📋 Sequence emails are automatically sent to participants when they join an event. Create them in order - #1 first, #2 second, etc.
            </p>

            <div class="tabs">
                <button class="tab active" data-tab="overview">📋 Event Sequences</button>
                <button class="tab" data-tab="emails">📧 All Emails</button>
                <button class="tab" data-tab="create">✏️ Create/Edit</button>
                <button class="tab" data-tab="detail">📊 Delivery Log</button>
            </div>

            <!-- Event Sequences Overview Tab -->
            <div id="tab-overview" class="tab-content active">
                <div id="sequences-by-event"></div>
            </div>

            <!-- All Emails List Tab -->
            <div id="tab-emails" class="tab-content">
                <div class="panel">
                    <div class="panel-header">
                        <span class="panel-title">All Sequence Emails</span>
                    </div>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Subject</th>
                                <th>Event</th>
                                <th>Sent</th>
                                <th>Failed</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="campaigns-body">
                            <tr><td colspan="7" class="empty-state">Loading...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Create/Edit Tab -->
            <div id="tab-create" class="tab-content">
                <div class="panel">
                    <div class="panel-header">
                        <span class="panel-title" id="form-title">Create New Campaign</span>
                    </div>
                    <div class="panel-body">
                        <input type="hidden" id="campaign-id">
                        
                        <div class="form-row">
                            <div class="form-group">
                                <label>Event *</label>
                                <select id="campaign-event" required>
                                    <option value="">Select event...</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Sequence Order</label>
                                <p style="font-size: 0.85rem; color: var(--admin-text-muted); margin-top: 8px;" id="sequence-order-info">
                                    This will be sequence #<span id="sequence-number">1</span> for the selected event.
                                </p>
                            </div>
                        </div>
                        <input type="hidden" name="campaign-type" value="sequence">

                        <div class="form-group">
                            <label>Subject *</label>
                            <input type="text" id="campaign-subject" placeholder="Welcome to ACDC 2026!" required>
                        </div>

                        <div class="form-group">
                            <label>Content *</label>
                            <div id="editor"></div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>CTA Button URL (optional)</label>
                                <input type="url" id="campaign-cta-url" placeholder="https://...">
                            </div>
                            <div class="form-group">
                                <label>CTA Button Text (optional)</label>
                                <input type="text" id="campaign-cta-text" placeholder="View Details">
                            </div>
                        </div>

                        <div class="btn-row">
                            <button class="btn btn-primary" onclick="saveCampaign()">💾 Save Campaign</button>
                            <button class="btn btn-secondary" onclick="previewCampaign()">👁️ Preview</button>
                            <button class="btn btn-secondary" onclick="cancelEdit()">Cancel</button>
                            <button class="btn btn-danger hidden" id="delete-campaign-btn" onclick="deleteCampaign()">🗑️ Delete</button>
                        </div>
                    </div>
                </div>

                <!-- Preview -->
                <div class="panel">
                    <div class="panel-header">Preview</div>
                    <div class="panel-body">
                        <iframe id="preview-frame" class="preview-frame"></iframe>
                    </div>
                </div>
            </div>

            <!-- Sequence Detail Tab -->
            <div id="tab-detail" class="tab-content">
                <div class="panel">
                    <div class="panel-header">
                        <span class="panel-title" id="detail-title">Sequence Email Details</span>
                        <span class="badge sequence" style="font-size: 0.85rem;">Auto-sent to new joiners</span>
                    </div>
                    <div class="panel-body">
                        <div class="stats-row">
                            <div class="stat">
                                <div class="value" id="stat-total">0</div>
                                <div class="label">Total Sent</div>
                            </div>
                            <div class="stat">
                                <div class="value" id="stat-delivered" style="color: var(--admin-success);">0</div>
                                <div class="label">Delivered</div>
                            </div>
                            <div class="stat">
                                <div class="value" id="stat-failed" style="color: var(--admin-danger);">0</div>
                                <div class="label">Failed</div>
                            </div>
                        </div>

                        <h3 style="margin: 20px 0 12px; font-size: 0.9rem;">Delivery Log</h3>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Recipient</th>
                                    <th>Status</th>
                                    <th>Sent At</th>
                                    <th>Error</th>
                                </tr>
                            </thead>
                            <tbody id="deliveries-body">
                                <tr><td colspan="4" class="empty-state">Select a campaign to view deliveries</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Copy Sequence Modal -->
    <div id="copy-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>📋 Copy Sequence to Another Event</h3>
            </div>
            <div class="modal-body">
                <p style="margin-bottom: 16px; color: var(--admin-text-muted); font-size: 0.9rem;">
                    <strong id="copy-source-name"></strong> will be copied to the selected event.
                </p>
                
                <div class="warning-box" id="copy-warning" style="display: none;">
                    ⚠️ <strong>Warning:</strong> The target event already has a sequence. This will replace it.
                </div>
                
                <div class="form-group">
                    <label>Target Event *</label>
                    <select id="copy-target-event" required>
                        <option value="">Select event...</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeCopyModal()">Cancel</button>
                <button class="btn btn-primary" onclick="confirmCopy()">📋 Copy Sequence</button>
            </div>
        </div>
    </div>

    <!-- Sequence emails are auto-sent, no manual send modal needed -->

    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <script src="https://unpkg.com/quill-image-resize-module@3.0.0/image-resize.min.js"></script>
    <script src="https://unpkg.com/quill-image-drop-module@1.0.3/image-drop.min.js"></script>
    <script src="https://alcdn.msauth.net/browser/2.38.0/js/msal-browser.min.js"></script>
    <script src="js/config.js"></script>
    <script src="js/api.js"></script>
    <script src="js/auth.js"></script>
    <script src="js/admin-sidebar.js"></script>
    <script>
        let quill;
        let allCampaigns = [];
        let allEvents = [];
        let currentCampaign = null;
        let eventParticipants = [];
        let copyingSequenceId = null;

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        async function init() {
            Auth.init();
            renderAdminSidebar('campaigns');
            await Auth.handleRedirect();

            if (!Auth.isLoggedIn()) {
                window.location.href = '/login.html';
                return;
            }

            // Initialize Quill editor
            quill = new Quill('#editor', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline'],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        ['link', 'image'],
                        ['clean']
                    ],
                    imageResize: {},
                    imageDrop: true
                }
            });

            // Setup tabs
            document.querySelectorAll('.tab').forEach(tab => {
                tab.addEventListener('click', () => switchTab(tab.dataset.tab));
            });

            // Load data
            await loadEvents();
            await loadCampaigns();

            // Event filter change
            document.getElementById('event-filter').addEventListener('change', loadCampaigns);
            
            // Update sequence order when event changes in form
            document.getElementById('campaign-event').addEventListener('change', updateSequenceOrderDisplay);
            
            // Copy target event change
            document.getElementById('copy-target-event').addEventListener('change', checkCopyTargetHasSequence);
        }

        async function updateSequenceOrderDisplay() {
            const eventId = document.getElementById('campaign-event').value;
            const campaignId = document.getElementById('campaign-id').value;
            const sequenceInfo = document.getElementById('sequence-order-info');
            
            if (!eventId) {
                sequenceInfo.textContent = 'Select an event to see sequence order';
                return;
            }

            // Count existing sequences for this event
            const existingSequences = allCampaigns.filter(c => 
                c.eventId === eventId && c.id !== campaignId
            ).length;

            if (campaignId) {
                // Editing - show current order
                const current = allCampaigns.find(c => c.id === campaignId);
                sequenceInfo.textContent = `This is sequence #${current?.sequenceOrder || 1} of ${existingSequences + 1} for this event`;
            } else {
                // Creating - will be next in order
                sequenceInfo.textContent = `This will be sequence #${existingSequences + 1} for this event`;
            }
        }

        function switchTab(tabName) {
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            document.querySelector(`.tab[data-tab="${tabName}"]`).classList.add('active');
            document.getElementById(`tab-${tabName}`).classList.add('active');
        }

        async function loadEvents() {
            try {
                const response = await API.events.list();
                allEvents = response.events || response || [];
                
                const eventFilter = document.getElementById('event-filter');
                const campaignEvent = document.getElementById('campaign-event');
                
                allEvents.forEach(event => {
                    eventFilter.innerHTML += `<option value="${event.id}">${escapeHtml(event.name)}</option>`;
                    campaignEvent.innerHTML += `<option value="${event.id}">${escapeHtml(event.name)}</option>`;
                });
            } catch (err) {
                console.error('Failed to load events:', err);
            }
        }

        async function loadCampaigns() {
            try {
                const eventId = document.getElementById('event-filter').value || null;
                const response = await API.campaigns.list(eventId);
                allCampaigns = response.campaigns || [];
                renderSequenceOverview();
                renderCampaigns();
            } catch (err) {
                console.error('Failed to load campaigns:', err);
                document.getElementById('campaigns-body').innerHTML = 
                    '<tr><td colspan="7" class="empty-state">Failed to load campaigns</td></tr>';
            }
        }

        function renderSequenceOverview() {
            const container = document.getElementById('sequences-by-event');
            
            // Group sequences by event
            const eventGroups = {};
            allEvents.forEach(event => {
                eventGroups[event.id] = {
                    event: event,
                    sequences: allCampaigns.filter(c => c.eventId === event.id)
                        .sort((a, b) => (a.sequenceOrder || 0) - (b.sequenceOrder || 0))
                };
            });
            
            // Filter to only events with sequences or all if no filter
            const eventFilter = document.getElementById('event-filter').value;
            let eventsToShow = eventFilter 
                ? allEvents.filter(e => e.id === eventFilter)
                : allEvents;
            
            if (!eventFilter) {
                // If no filter, only show events that have sequences
                eventsToShow = eventsToShow.filter(e => eventGroups[e.id].sequences.length > 0);
            }
            
            if (eventsToShow.length === 0) {
                container.innerHTML = '<div class="empty-state">No sequences found. Create your first sequence email!</div>';
                return;
            }
            
            container.innerHTML = eventsToShow.map(event => {
                const group = eventGroups[event.id];
                const sequences = group.sequences;
                const totalSent = sequences.reduce((sum, s) => sum + (s.stats?.sent || 0), 0);
                const totalFailed = sequences.reduce((sum, s) => sum + (s.stats?.failed || 0), 0);
                
                return `
                    <div class="event-sequence-card">
                        <div class="event-sequence-header">
                            <div>
                                <h3>${escapeHtml(event.name)}</h3>
                                <div class="event-meta">
                                    ${sequences.length} email${sequences.length !== 1 ? 's' : ''} • 
                                    ${totalSent} sent • 
                                    ${totalFailed} failed
                                </div>
                            </div>
                            <button class="btn btn-sm btn-primary" onclick="showCreateFormForEvent('${event.id}')">➕ Add Email</button>
                        </div>
                        <div class="event-sequence-body">
                            ${sequences.length === 0 ? 
                                '<div class="no-sequence">No sequence emails yet. Click "Add Email" to create one.</div>' :
                                sequences.map(seq => `
                                    <div class="sequence-item">
                                        <div class="sequence-info">
                                            <div class="sequence-subject">
                                                <span class="badge sequence">#${seq.sequenceOrder || 1}</span>
                                                ${escapeHtml(seq.subject)}
                                            </div>
                                            <div class="sequence-stats">
                                                <span style="color: var(--admin-success);">${seq.stats?.sent || 0} sent</span> • 
                                                <span style="color: var(--admin-danger);">${seq.stats?.failed || 0} failed</span> • 
                                                Created ${new Date(seq.createdAt).toLocaleDateString()}
                                            </div>
                                        </div>
                                        <div class="sequence-actions">
                                            <button class="btn btn-sm btn-secondary" onclick="viewCampaign('${seq.id}')">📊 View</button>
                                            <button class="btn btn-sm btn-secondary" onclick="editSequenceFromOverview('${seq.id}', '${event.id}')">✏️ Edit</button>
                                            <button class="btn btn-sm btn-secondary" onclick="showCopyModal('${seq.id}')">📋 Copy</button>
                                        </div>
                                    </div>
                                `).join('')
                            }
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderCampaigns() {
            const tbody = document.getElementById('campaigns-body');

            if (allCampaigns.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="empty-state">No sequence emails yet. Create your first one!</td></tr>';
                return;
            }

            // Sort by event, then by sequence order
            allCampaigns.sort((a, b) => {
                if (a.eventId !== b.eventId) return a.eventId.localeCompare(b.eventId);
                return (a.sequenceOrder || 0) - (b.sequenceOrder || 0);
            });

            tbody.innerHTML = allCampaigns.map(campaign => {
                const event = allEvents.find(e => e.id === campaign.eventId);
                const createdDate = new Date(campaign.createdAt).toLocaleDateString();

                return `
                    <tr>
                        <td><span class="badge sequence">#${campaign.sequenceOrder || 1}</span></td>
                        <td><strong>${escapeHtml(campaign.subject)}</strong></td>
                        <td>${escapeHtml(event?.name || campaign.eventId)}</td>
                        <td><span style="color: var(--admin-success);">${campaign.stats?.sent || 0}</span></td>
                        <td><span style="color: var(--admin-danger);">${campaign.stats?.failed || 0}</span></td>
                        <td>${createdDate}</td>
                        <td>
                            <button class="btn btn-sm btn-secondary" onclick="viewCampaign('${campaign.id}')">📊 View</button>
                            <button class="btn btn-sm btn-secondary" onclick="editCampaign('${campaign.id}')">✏️ Edit</button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function showCreateForm() {
            document.getElementById('campaign-id').value = '';
            document.getElementById('form-title').textContent = 'Create New Sequence Email';
            document.getElementById('campaign-event').value = document.getElementById('event-filter').value || '';
            document.getElementById('campaign-subject').value = '';
            quill.setContents([]);
            document.getElementById('campaign-cta-url').value = '';
            document.getElementById('campaign-cta-text').value = '';
            document.getElementById('delete-campaign-btn').classList.add('hidden');
            
            // Update sequence order display
            updateSequenceOrderDisplay();

            switchTab('create');
        }

        function showCreateFormForEvent(eventId) {
            document.getElementById('campaign-id').value = '';
            document.getElementById('form-title').textContent = 'Create New Sequence Email';
            document.getElementById('campaign-event').value = eventId;
            document.getElementById('campaign-subject').value = '';
            quill.setContents([]);
            document.getElementById('campaign-cta-url').value = '';
            document.getElementById('campaign-cta-text').value = '';
            document.getElementById('delete-campaign-btn').classList.add('hidden');
            
            // Update sequence order display
            updateSequenceOrderDisplay();

            switchTab('create');
        }

        function editSequenceFromOverview(sequenceId, eventId) {
            // Set the event filter then edit
            document.getElementById('event-filter').value = eventId;
            editCampaign(sequenceId);
        }

        async function editCampaign(campaignId) {
            try {
                const response = await API.campaigns.get(campaignId);
                const campaign = response.campaign;
                currentCampaign = campaign;

                document.getElementById('campaign-id').value = campaign.id;
                document.getElementById('form-title').textContent = 'Edit Sequence Email';
                document.getElementById('campaign-event').value = campaign.eventId;
                document.getElementById('campaign-subject').value = campaign.subject;
                quill.root.innerHTML = campaign.content;
                document.getElementById('campaign-cta-url').value = campaign.ctaUrl || '';
                document.getElementById('campaign-cta-text').value = campaign.ctaText || '';
                document.getElementById('delete-campaign-btn').classList.remove('hidden');

                // Update sequence order display
                updateSequenceOrderDisplay();

                switchTab('create');
            } catch (err) {
                console.error('Failed to load campaign:', err);
                alert('Failed to load campaign');
            }
        }

        async function saveCampaign() {
            const eventId = document.getElementById('campaign-event').value;
            const subject = document.getElementById('campaign-subject').value.trim();
            const content = quill.root.innerHTML;
            const type = document.querySelector('input[name="campaign-type"]').value;
            const ctaUrl = document.getElementById('campaign-cta-url').value.trim();
            const ctaText = document.getElementById('campaign-cta-text').value.trim();

            if (!eventId || !subject || !content) {
                alert('Please fill in all required fields');
                return;
            }

            // VALIDATION: Only 1 sequence allowed per event
            const campaignId = document.getElementById('campaign-id').value;
            const existingSequence = allCampaigns.find(c => 
                c.eventId === eventId && 
                c.type === 'sequence' && 
                c.id !== campaignId
            );
            
            if (existingSequence) {
                alert(`This event already has a sequence: "${existingSequence.subject}".\n\nOnly 1 sequence is allowed per event. Please delete the existing sequence first, or edit it instead of creating a new one.`);
                return;
            }

            try {
                const data = { eventId, subject, content, type, ctaUrl, ctaText };

                if (campaignId) {
                    await API.campaigns.update(campaignId, data);
                } else {
                    await API.campaigns.create(data);
                }

                await loadCampaigns();
                switchTab('overview');
            } catch (err) {
                console.error('Failed to save campaign:', err);
                alert('Failed to save campaign: ' + err.message);
            }
        }

        async function deleteCampaign() {
            const campaignId = document.getElementById('campaign-id').value;
            if (!campaignId) return;

            if (!confirm('Are you sure you want to delete this campaign? This will also delete all delivery records.')) {
                return;
            }

            try {
                await API.campaigns.delete(campaignId);
                await loadCampaigns();
                switchTab('overview');
            } catch (err) {
                console.error('Failed to delete campaign:', err);
                alert('Failed to delete campaign');
            }
        }

        function cancelEdit() {
            switchTab('overview');
        }

        async function previewCampaign() {
            const subject = document.getElementById('campaign-subject').value.trim();
            const content = quill.root.innerHTML;
            const ctaUrl = document.getElementById('campaign-cta-url').value.trim();
            const ctaText = document.getElementById('campaign-cta-text').value.trim();

            try {
                const response = await fetch(`${CONFIG.api.baseUrl}/email/preview`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        templateId: 'announcement',
                        data: {
                            subject,
                            firstName: 'Preview User',
                            content,
                            ctaUrl,
                            ctaText
                        }
                    })
                });

                if (response.ok) {
                    const data = await response.json();
                    const frame = document.getElementById('preview-frame');
                    frame.srcdoc = data.html;
                }
            } catch (err) {
                console.error('Preview error:', err);
            }
        }

        async function viewCampaign(campaignId) {
            try {
                const response = await API.campaigns.get(campaignId);
                currentCampaign = response.campaign;
                const deliveries = response.deliveries || [];

                document.getElementById('detail-title').textContent = `#${currentCampaign.sequenceOrder || 1} - ${currentCampaign.subject}`;
                document.getElementById('stat-total').textContent = response.stats?.total || 0;
                document.getElementById('stat-delivered').textContent = response.stats?.sent || 0;
                document.getElementById('stat-failed').textContent = response.stats?.failed || 0;

                const tbody = document.getElementById('deliveries-body');
                if (deliveries.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="4" class="empty-state">No deliveries yet - emails are sent automatically when users join teams</td></tr>';
                } else {
                    tbody.innerHTML = deliveries.map(d => {
                        const statusBadge = `<span class="badge ${d.status}">${d.status}</span>`;
                        const sentAt = d.sentAt ? new Date(d.sentAt).toLocaleString() : '-';
                        return `
                            <tr>
                                <td>${escapeHtml(d.userName || d.email)}</td>
                                <td>${statusBadge}</td>
                                <td>${sentAt}</td>
                                <td style="color: var(--admin-danger);">${escapeHtml(d.error || '-')}</td>
                            </tr>
                        `;
                    }).join('');
                }

                switchTab('detail');
            } catch (err) {
                console.error('Failed to load campaign:', err);
                alert('Failed to load campaign details');
            }
        }

        // Sequence emails are auto-sent when users join teams
        // No manual send functions needed

        // Copy modal functions
        function showCopyModal(sequenceId) {
            copyingSequenceId = sequenceId;
            const sequence = allCampaigns.find(c => c.id === sequenceId);
            
            if (!sequence) return;
            
            const sourceEvent = allEvents.find(e => e.id === sequence.eventId);
            document.getElementById('copy-source-name').textContent = 
                `"${sequence.subject}" from ${sourceEvent?.name || 'Unknown Event'}`;
            
            // Populate target event dropdown (exclude source event)
            const select = document.getElementById('copy-target-event');
            select.innerHTML = '<option value="">Select event...</option>';
            allEvents
                .filter(e => e.id !== sequence.eventId)
                .forEach(event => {
                    select.innerHTML += `<option value="${event.id}">${escapeHtml(event.name)}</option>`;
                });
            
            document.getElementById('copy-warning').style.display = 'none';
            document.getElementById('copy-modal').classList.add('active');
        }
        
        function closeCopyModal() {
            copyingSequenceId = null;
            document.getElementById('copy-modal').classList.remove('active');
        }
        
        function checkCopyTargetHasSequence() {
            const targetEventId = document.getElementById('copy-target-event').value;
            const warning = document.getElementById('copy-warning');
            
            if (!targetEventId) {
                warning.style.display = 'none';
                return;
            }
            
            const existingSequence = allCampaigns.find(c => c.eventId === targetEventId);
            warning.style.display = existingSequence ? 'block' : 'none';
        }
        
        async function confirmCopy() {
            const targetEventId = document.getElementById('copy-target-event').value;
            
            if (!targetEventId) {
                alert('Please select a target event');
                return;
            }
            
            const sourceSequence = allCampaigns.find(c => c.id === copyingSequenceId);
            if (!sourceSequence) return;
            
            // Check if target already has a sequence
            const existingSequence = allCampaigns.find(c => c.eventId === targetEventId);
            
            if (existingSequence) {
                if (!confirm(`The target event already has a sequence: "${existingSequence.subject}".\n\nThis will be deleted and replaced with the copied sequence. Continue?`)) {
                    return;
                }
                
                // Delete existing sequence
                try {
                    await API.campaigns.delete(existingSequence.id);
                } catch (err) {
                    console.error('Failed to delete existing sequence:', err);
                    alert('Failed to delete existing sequence');
                    return;
                }
            }
            
            // Create copy with new eventId
            try {
                await API.campaigns.create({
                    eventId: targetEventId,
                    subject: sourceSequence.subject,
                    content: sourceSequence.content,
                    type: 'sequence',
                    ctaUrl: sourceSequence.ctaUrl,
                    ctaText: sourceSequence.ctaText
                });
                
                await loadCampaigns();
                closeCopyModal();
                
                const targetEvent = allEvents.find(e => e.id === targetEventId);
                alert(`Sequence copied successfully to ${targetEvent?.name || 'event'}!`);
            } catch (err) {
                console.error('Failed to copy sequence:', err);
                alert('Failed to copy sequence: ' + err.message);
            }
        }

        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
